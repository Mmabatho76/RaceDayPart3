@model List<ResultDto>
@{ViewData["Title"]="My results";}<h1 class="h2 fw-bold">My race results</h1><div class="card"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th></tr></thead><tbody>@foreach(var r in Model){<tr><td>@r.EventName</td><td>@r.EventDate.ToString("dd MMM yyyy")</td><td>@r.CategoryName</td><td>@r.FinishTime</td><td>@r.FinishPosition.ToString()@((r.FinishPosition%100>=11&&r.FinishPosition%100<=13)?"th":r.FinishPosition%10==1?"st":r.FinishPosition%10==2?"nd":r.FinishPosition%10==3?"rd":"th") of @r.TotalFinishers</td></tr>}</tbody></table></div></div>
