@model EventDto
@{ViewData["Title"]=Model.Name;}<a asp-controller="Home" asp-action="Index">← All events</a><div class="card mt-3"><div class="card-body p-4">@if(!string.IsNullOrEmpty(Model.BannerUrl)){<img src="@Model.BannerUrl" class="img-fluid rounded mb-3" alt="Event banner"/>}<div class="event-date">@Model.EventDate.ToString("dddd, dd MMMM yyyy")</div><h1 class="display-6 fw-bold">@Model.Name</h1><p class="lead">@Model.Location · @Model.DistanceKm km · @Model.EventType</p><p>@Model.Description</p><h2 class="h5 mt-4">Available categories</h2>@if(Model.Categories!=null){@foreach(var c in Model.Categories){<div class="border rounded p-3 mb-2 d-flex justify-content-between align-items-center"><div><strong>@c.Name</strong><div class="text-secondary small">@c.Description · @c.DistanceKm km · @c.AgeRange</div></div><form method="post" asp-action="Enrol"><input type="hidden" name="eventId" value="@Model.EventId"/><input type="hidden" name="categoryId" value="@c.CategoryId"/><button class="btn btn-primary">Enter event</button></form></div>}}else{<p>No categories have been added yet.</p>}</div></div>
