@model UserDto
@{ViewData["Title"]="My profile";}<h1 class="h2 fw-bold">My profile</h1><div class="row g-3"><div class="col-md-6"><div class="card"><div class="card-body"><h2 class="h5">Personal information</h2><form method="post" asp-action="UpdateProfile"><div class="mb-3"><label class="form-label">Full name</label><input name="fullName" value="@Model.FullName" class="form-control" required/></div><div class="mb-3"><label class="form-label">Phone number</label><input name="phoneNumber" value="@Model.PhoneNumber" class="form-control" required/></div><p class="text-secondary">@Model.Email</p><button class="btn btn-primary">Save changes</button></form></div></div></div><div class="col-md-6"><div class="card"><div class="card-body"><h2 class="h5">Profile picture</h2>@if(!string.IsNullOrEmpty(Model.ProfilePictureUrl)){<img src="@Model.ProfilePictureUrl" class="rounded-circle mb-3" width="120" height="120"/>}<form method="post" enctype="multipart/form-data" asp-action="UploadPicture"><input type="file" name="file" class="form-control mb-3" accept="image/*" required/><button class="btn btn-primary">Upload picture</button></form></div></div></div></div>
