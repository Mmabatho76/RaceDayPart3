@model RegisterVm
@{ViewData["Title"]="Register";}<div class="row justify-content-center"><div class="col-md-7 col-lg-6"><div class="card"><div class="card-body p-4"><h1 class="h3 fw-bold">Create your account</h1><div asp-validation-summary="ModelOnly" class="text-danger"></div><form method="post"><div class="mb-3"><label asp-for="FullName" class="form-label">Full name</label><input asp-for="FullName" class="form-control"/></div><div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control"/></div><div class="mb-3"><label asp-for="PhoneNumber" class="form-label">Phone number</label><input asp-for="PhoneNumber" class="form-control"/></div><div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" type="password" class="form-control"/></div><div class="mb-3"><label asp-for="Role" class="form-label"></label><select asp-for="Role" class="form-select"><option>Participant</option><option>Organiser</option></select></div><div class="mb-3"><label asp-for="OrganiserCode" class="form-label">Organiser registration code (if required)</label><input asp-for="OrganiserCode" class="form-control"/></div><button class="btn btn-primary w-100">Register</button></form></div></div></div></div>
