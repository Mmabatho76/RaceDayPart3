@model EventVm
@{ViewData["Title"]="Edit event";ViewData["Heading"]="Edit event";}<h1 class="h2 fw-bold">@ViewData["Heading"]</h1><div class="card"><div class="card-body"><div asp-validation-summary="ModelOnly" class="text-danger"></div><form method="post" enctype="multipart/form-data"><input asp-for="EventId" type="hidden"/><div class="mb-3"><label asp-for="Name" class="form-label">Event name</label><input asp-for="Name" class="form-control"/></div><div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div><div class="row"><div class="col-md-6 mb-3"><label asp-for="EventDate" class="form-label"></label><input asp-for="EventDate" type="date" class="form-control"/></div><div class="col-md-6 mb-3"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control"/></div></div><div class="row"><div class="col-md-6 mb-3"><label asp-for="DistanceKm" class="form-label">Distance (km)</label><input asp-for="DistanceKm" class="form-control"/></div><div class="col-md-6 mb-3"><label asp-for="EventTypeId" class="form-label">Event type</label><select asp-for="EventTypeId" class="form-select"><option value="1">Run</option><option value="2">Walk</option><option value="3">Cycle</option></select></div></div><div class="mb-3"><label asp-for="Banner" class="form-label">Event banner image (optional)</label><input asp-for="Banner" type="file" class="form-control" accept="image/*"/></div><button class="btn btn-primary">Save event</button><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></form></div></div>