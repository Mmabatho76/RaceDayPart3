@model List<EnrolmentDto>
@{ViewData["Title"]="Enrolments";}<h1 class="h2 fw-bold">Event enrolments</h1><div class="card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Participant</th><th>Email</th><th>Category</th><th>Status</th><th>Publish result</th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.ParticipantName</td><td>@e.ParticipantEmail</td><td>@e.CategoryName</td><td>@e.Status</td><td><form method="post" asp-action="CaptureResult" class="d-flex gap-1 flex-wrap"><input type="hidden" name="EnrolmentId" value="@e.EnrolmentId"/><input name="FinishTimeSeconds" type="number" min="1" placeholder="Time seconds" class="form-control form-control-sm" style="width:110px" required/><input name="FinishPosition" type="number" min="1" placeholder="Position" class="form-control form-control-sm" style="width:90px" required/><input name="TotalFinishers" type="number" min="1" placeholder="Finishers" class="form-control form-control-sm" style="width:95px" required/><button class="btn btn-sm btn-primary">Publish</button></form></td></tr>}</tbody></table></div></div>
