@model List<CategoryDto>
@{ViewData["Title"]="Categories";}<h1 class="h2 fw-bold">Event categories</h1><div class="row g-3"><div class="col-lg-7"><div class="card"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Name</th><th>Age</th><th>Distance</th></tr></thead><tbody>@foreach(var c in Model){<tr><td>@c.Name</td><td>@c.AgeRange</td><td>@c.DistanceKm km</td></tr>}</tbody></table></div></div></div><div class="col-lg-5"><div class="card"><div class="card-body"><h2 class="h5">Add category</h2><form method="post" asp-action="AddCategory" asp-route-id="@ViewBag.EventId"><div class="mb-2"><label class="form-label">Name</label><input name="Name" class="form-control" required/></div><div class="mb-2"><label class="form-label">Description</label><input name="Description" class="form-control" required/></div><div class="row"><div class="col"><label class="form-label">Min age</label><input name="MinAge" type="number" class="form-control"/></div><div class="col"><label class="form-label">Max age</label><input name="MaxAge" type="number" class="form-control"/></div></div><div class="my-2"><label class="form-label">Distance km</label><input name="DistanceKm" type="number" step=".1" value="5" class="form-control"/></div><button class="btn btn-primary">Add category</button></form></div></div></div></div>
