@model List<EventDto>
@{ViewData["Title"]="Organiser dashboard";}<div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="h2 fw-bold">Organiser dashboard</h1><p class="text-secondary">Manage your races and participants.</p></div><a class="btn btn-primary" asp-action="Create">+ Create event</a></div><div class="row g-3 mb-4"><div class="col-md-4"><div class="card card-body"><div class="text-secondary">Events created</div><div class="display-6 fw-bold">@Model.Count</div></div></div><div class="col-md-4"><div class="card card-body"><div class="text-secondary">Total enrolments</div><div class="display-6 fw-bold">@Model.Sum(x=>x.EnrolmentCount??0)</div></div></div><div class="col-md-4"><div class="card card-body"><div class="text-secondary">Upcoming events</div><div class="display-6 fw-bold">@Model.Count(x=>x.EventDate>=DateTime.Today)</div></div></div></div><div class="card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Event</th><th>Date</th><th>Enrolments</th><th>Manage</th></tr></thead><tbody>@foreach(var e in Model){<tr><td><strong>@e.Name</strong><div class="small text-secondary">@e.Location · @e.DistanceKm km</div></td><td>@e.EventDate.ToString("dd MMM yyyy")</td><td>@(e.EnrolmentCount??0)</td><td class="d-flex flex-wrap gap-1"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@e.EventId">Edit</a><a class="btn btn-sm btn-outline-secondary" asp-action="Categories" asp-route-id="@e.EventId">Categories</a><a class="btn btn-sm btn-outline-secondary" asp-action="Enrolments" asp-route-id="@e.EventId">Enrolments/results</a><form method="post" asp-action="Delete" onsubmit="return confirm('Delete this event?')"><input type="hidden" name="id" value="@e.EventId"/><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr>}</tbody></table></div></div>
