@model List<EventDto>
@{ViewData["Title"]="Upcoming races";}<section class="hero mb-4"><span class="text-warning fw-bold">FIND YOUR NEXT CHALLENGE</span><h1 class="display-5 fw-bold mt-2">Every finish line starts somewhere.</h1><p class="lead">Discover races, enter events and track your progress with RaceDay.</p><a class="btn btn-warning btn-lg" asp-controller="Account" asp-action="Register">Join RaceDay</a></section><form method="get" class="row g-2 mb-4"><div class="col-md-5"><input name="location" class="form-control" placeholder="Filter by location"/></div><div class="col-md-4"><select name="type" class="form-select"><option value="">All event types</option><option>Run</option><option>Walk</option><option>Cycle</option></select></div><div class="col-md-3"><button class="btn btn-dark w-100">Filter events</button></div></form><h2 class="h3 mb-3">Upcoming events</h2><div class="row g-3">@foreach(var ev in Model){<div class="col-md-6 col-lg-4"><div class="card h-100"><div class="card-body">@if(!string.IsNullOrEmpty(ev.BannerUrl)){<img src="@ev.BannerUrl" class="img-fluid rounded mb-3" alt="Event banner"/>}<div class="event-date">@ev.EventDate.ToString("dd MMM yyyy")</div><h3 class="h5 mt-2">@ev.Name</h3><p class="text-secondary">@ev.Location · @ev.DistanceKm km · @ev.EventType</p><p>@ev.Description</p><a class="btn btn-primary" asp-controller="Participant" asp-action="Event" asp-route-id="@ev.EventId">View event</a></div></div></div>}@if(!Model.Any()){<p>No upcoming events found.</p>}</div>
